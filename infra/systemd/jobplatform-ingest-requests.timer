[Unit]
Description=US Fresh Jobs — poll for on-demand fetch requests

[Timer]
# Every minute. The check is one indexed query against a partial index, so an idle minute
# costs almost nothing, and a minute is short enough that the button feels responsive
# without the console needing to hold a connection open.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s

[Install]
WantedBy=timers.target
