# =============================================================================
# job-platform — environment template
# Copy to .env.development and fill in. NEVER commit a filled-in file.
# Every value here is a non-secret placeholder.
# =============================================================================

ENVIRONMENT=development           # development | test | production
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jobplatform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jobplatform:CHANGE_ME@postgres:5432/jobplatform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (S3-compatible; MinIO locally) --------------------------
OBJECT_STORAGE_URL=http://minio:9000
OBJECT_STORAGE_BUCKET=jobplatform-raw
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false

# --- Security ---------------------------------------------------------------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_64_BYTE_URLSAFE_TOKEN
JWT_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_64_BYTE_TOKEN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Rate limiting (requests / minute) --------------------------------------
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_ENABLED=true

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100

# --- Source: OpenJobData ----------------------------------------------------
# VERIFIED 2026-08-10 — see docs/00-source-verification.md
OPENJOBDATA_ENABLED=true
OPENJOBDATA_BUCKET_URI=hf://buckets/Invicto69/Jobs-Dataset-bucket
# 'full' is REQUIRED: 'minimal' has no city/state/salary/description (source doc §5)
OPENJOBDATA_VARIANT=full
# entire_json excluded by projection -> halves transfer (238MB -> 120MB/day)
OPENJOBDATA_INCLUDE_ENTIRE_JSON=false
OPENJOBDATA_MAX_CONCURRENCY=2
OPENJOBDATA_REQUEST_TIMEOUT_SECONDS=300
OPENJOBDATA_RETRY_ATTEMPTS=5
# Optional; the bucket is public and needs no token. Leave blank.
HUGGINGFACE_TOKEN=

# --- Ingestion policy -------------------------------------------------------
INGEST_COUNTRY_ALLOWLIST=US
# Role scope. EMPTY = ingest every category (the default; the platform does not
# artificially limit jobs). Narrow it only when you deliberately want a niche board:
#   INGEST_CATEGORY_ALLOWLIST=data-engineering,data-analytics
# Leave empty to ingest every category.
# Skipped jobs are still recorded in sync_errors with reason CATEGORY_NOT_ALLOWED.
INGEST_CATEGORY_ALLOWLIST=data-engineering,data-analytics
INGEST_CATEGORY_BLOCKLIST=
INGEST_ROW_GROUP_BATCH_SIZE=8
INGEST_UPSERT_CHUNK_SIZE=5000
# Reject posted_at further in the future than this (source has real future dates)
INGEST_MAX_FUTURE_POSTED_AT_HOURS=24
INGEST_MIN_POSTED_AT_YEAR=2000
# Mark ACTIVE jobs REMOVED after this many days without being seen
LIFECYCLE_REMOVED_AFTER_DAYS=14

# --- Freshness window --------------------------------------------------------
# How old a job may be before it is retired from the board. 0 disables retention
# entirely, which is the shipped default: the platform's premise is that no qualifying
# job is ever dropped, so narrowing is opt-in.
#
# Age uses the employer's posted_at where it is trustworthy and our own first_seen_at
# where it is not -- roughly 17% of source rows carry no posting date, and judging those
# by detection time keeps them for a fair window instead of retiring them for a fault
# that is the source's, not the job's.
#
# scripts/daily.sh applies this with --expire-only, so a job past the window is marked
# EXPIRED and disappears from the board while the record survives. The API filters on
# status, so nothing further is needed to hide it.
RETENTION_MAX_POSTED_AGE_DAYS=0

# --- Observability ----------------------------------------------------------
METRICS_ENABLED=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Access control -----------------------------------------------------------
# Job data is only visible to users an administrator has approved. These bootstrap
# the first administrator via scripts/create_admin.py; nothing reads them at runtime,
# and the script refuses to run once an administrator exists.
#
# Use a real domain. Reserved names (.test, .local, .invalid) are rejected by the
# same validator the login endpoint uses, which would create an admin who cannot
# sign in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT_SECRET above signs session tokens. Changing it logs everyone out immediately,
# which is the intended lever if a token is ever believed to be compromised.
