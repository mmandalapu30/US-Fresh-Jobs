# PRODUCTION TEMPLATE — copy to .env.production on the host and fill in.
# .env.production is git-ignored. Every CHANGE_ME must be replaced with a value
# from your secret manager (AWS Secrets Manager / GCP Secret Manager / Vault).
# The API refuses to start in production if any CHANGE_ME value survives.

# =============================================================================
# job-platform — environment template
# Copy to .env.development and fill in. NEVER commit a filled-in file.
# Every value here is a non-secret placeholder.
# =============================================================================

# Public hostname. Caddy provisions a TLS certificate for whatever is set here, so it
# must be a real domain resolving to this host; use :80 to test before DNS exists.
SITE_ADDRESS=REPLACE-WITH-YOUR-DOMAIN

ENVIRONMENT=production           # development | test | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jobplatform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jobplatform:CHANGE_ME@postgres:5432/jobplatform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (self-hosted MinIO, part of the prod stack) -------------
# These are the MinIO root credentials AND the ingest's client credentials -- the compose
# file feeds the same pair to both.
# Both must be at least 32 characters. The production hardening check in
# jobplatform_shared/config.py refuses to start otherwise, and it applies to the ACCESS
# KEY too, not just the secret -- MinIO's own minimums are much lower and are not the
# binding constraint. Generate each: openssl rand -hex 24
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_BUCKET=jobplatform-raw
OBJECT_STORAGE_REGION=us-east-1
# The prod compose overrides these two with the internal address (http://minio:9000), so
# editing them here has no effect. They are present because the settings are required.
OBJECT_STORAGE_URL=http://minio:9000
OBJECT_STORAGE_USE_SSL=false
#
# To use an external S3 instead: delete the `minio` and `minio-init` services and the
# OBJECT_STORAGE_* overrides from infra/docker/docker-compose.prod.yml, then set
# OBJECT_STORAGE_URL=https://s3.REGION.amazonaws.com and OBJECT_STORAGE_USE_SSL=true.

# --- Security ---------------------------------------------------------------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_64_BYTE_URLSAFE_TOKEN
JWT_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_64_BYTE_TOKEN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Must be https and must not be '*' -- production hardening rejects both. This holds
# even while testing with SITE_ADDRESS=:80 over plain HTTP: use https://<host> anyway.
# Nothing breaks, because the browser never calls the API cross-origin (Next proxies
# it server-side), so this value is validated but effectively unused by the UI.
CORS_ALLOW_ORIGINS=https://REPLACE-WITH-YOUR-DOMAIN

# --- Rate limiting (requests / minute) --------------------------------------
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_ENABLED=true

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100

# --- Source: OpenJobData ----------------------------------------------------
# VERIFIED 2026-08-10 — see docs/00-source-verification.md
OPENJOBDATA_ENABLED=true
OPENJOBDATA_BUCKET_URI=hf://buckets/Invicto69/Jobs-Dataset-bucket
# 'full' is REQUIRED: 'minimal' has no city/state/salary/description (source doc §5)
OPENJOBDATA_VARIANT=full
# entire_json excluded by projection -> halves transfer (238MB -> 120MB/day)
OPENJOBDATA_INCLUDE_ENTIRE_JSON=false
OPENJOBDATA_MAX_CONCURRENCY=2
OPENJOBDATA_REQUEST_TIMEOUT_SECONDS=300
OPENJOBDATA_RETRY_ATTEMPTS=5
# Optional; the bucket is public and needs no token. Leave blank.
HUGGINGFACE_TOKEN=

# --- Ingestion policy -------------------------------------------------------
INGEST_COUNTRY_ALLOWLIST=US
# Role scope. EMPTY MEANS EVERY CATEGORY. That default is deliberate (the platform does
# not artificially limit jobs) but it is emphatically not what this deployment wants:
# leaving it unset once ingested 63,760 out-of-scope rows that had to be purged again.
# Slugs are listed in docs/06-role-filtering.md.
INGEST_CATEGORY_ALLOWLIST=workday,data-engineering,data-analytics,data-science,software,it-ops
INGEST_CATEGORY_BLOCKLIST=
# The peak is not the parquet read, it is the staging merge and the in-memory company
# registry further down the pipeline. At 8 row groups the ingest reached 3.0 GB resident
# on a 4 GB host and the kernel killed it on every scheduled run for a day. A killed
# worker never finalises its sync_runs row, so the corpse holds the per-source lock and
# blocks the next run too -- the failure compounds instead of retrying. Raise only where
# there is memory to spare, and watch `docker stats` while you do.
INGEST_ROW_GROUP_BATCH_SIZE=2
INGEST_UPSERT_CHUNK_SIZE=5000
# Reject posted_at further in the future than this (source has real future dates)
INGEST_MAX_FUTURE_POSTED_AT_HOURS=24
INGEST_MIN_POSTED_AT_YEAR=2000
# How long an abandoned RUNNING sync run holds the per-source lock before the next run
# reclaims it. This is the dead time a crash costs: at the former 120 minutes, three OOM
# kills in one afternoon cost six hours of ingestion, each kill wedging the lock so every
# 10-minute watch pass bailed out and the admin console answered "Another ingest was
# already running." Must stay well above a real run -- reclaiming a live worker frees the
# lock for a second run that then collides on the provenance UNIQUE. Scheduled runs take
# 2-5 minutes here; the longest manual backfill observed was 16.
INGEST_STALE_RUN_RECLAIM_MINUTES=30
# Mark ACTIVE jobs REMOVED after this many days without being seen
LIFECYCLE_REMOVED_AFTER_DAYS=14

# --- Freshness window --------------------------------------------------------
# How old a job may be before it is retired from the board. 0 disables retention
# entirely, which is the shipped default: the platform's premise is that no qualifying
# job is ever dropped, so narrowing is opt-in.
#
# Age uses the employer's posted_at where it is trustworthy and our own first_seen_at
# where it is not -- roughly 17% of source rows carry no posting date, and judging those
# by detection time keeps them for a fair window instead of retiring them for a fault
# that is the source's, not the job's.
#
# scripts/daily.sh applies this with --expire-only, so a job past the window is marked
# EXPIRED and disappears from the board while the record survives. The API filters on
# status, so nothing further is needed to hide it.
RETENTION_MAX_POSTED_AGE_DAYS=0

# --- Observability ----------------------------------------------------------
METRICS_ENABLED=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
